# Database — Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# App
NODE_ENV=development
PORT=3001

# App URL (production only — used for CORS)
# APP_URL=https://command-central.up.railway.app

# WebAuthn (production only — defaults to localhost for dev)
# WEBAUTHN_RP_ID=command-central.up.railway.app
# WEBAUTHN_ORIGIN=https://command-central.up.railway.app

# Legacy integrations (optional, local dev only)
# JIRA_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# HARVEST_ACCOUNT_ID=
# HARVEST_ACCESS_TOKEN=

# Local Postgres (docker-compose, dev only)
# POSTGRES_USER=cc
# POSTGRES_PASSWORD=cc_dev
# POSTGRES_DB=command_central
